# Local .terraform directories (contains plugins and provider binaries)
**/.terraform/*

# .tfstate files (contains sensitive backend state data and secrets)
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files by default as they contain sensitive credentials/secrets
*.tfvars
*.tfvars.json

# Ignore override files used for local modifications
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Ignore plan outputs if you save plans locally (optional but recommended)
*tfplan*